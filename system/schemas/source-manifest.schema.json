{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-desk.local/schemas/source-manifest/1.0.0",
  "title": "Knowledge Desk source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_id", "media_type", "content_hash", "original_filename", "original_path", "normalized_path", "normalized_hash", "normalization", "title", "creator", "publication_date", "ingested_at", "canonical_url", "language", "extraction_status", "warnings", "extensions"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "source_id": {"type": "string", "pattern": "^src-[0-9a-f]{24}$"},
    "media_type": {"enum": ["application/pdf", "text/markdown", "text/plain"]},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "original_filename": {"type": "string", "minLength": 1},
    "original_path": {"type": "string", "pattern": "^sources/src-[0-9a-f]{24}/original/[^/]+$"},
    "normalized_path": {"$ref": "#/$defs/normalized_path"},
    "normalized_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_revision", "revisions"],
      "properties": {
        "current_revision": {"type": "string", "pattern": "^norm-[0-9a-f]{16}$"},
        "revisions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/normalization_revision"}
        }
      }
    },
    "title": {"type": ["string", "null"], "minLength": 1},
    "creator": {"type": ["string", "null"], "minLength": 1},
    "publication_date": {"type": ["string", "null"], "format": "date"},
    "ingested_at": {"type": "string", "format": "date-time"},
    "canonical_url": {"type": ["string", "null"], "format": "uri"},
    "language": {"type": ["string", "null"], "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"},
    "extraction_status": {"enum": ["complete", "partial", "needs_ocr"]},
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "page_count": {"type": "integer", "minimum": 1},
    "revision_of": {"type": ["string", "null"], "pattern": "^src-[0-9a-f]{24}$"},
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "$defs": {
    "normalized_path": {
      "type": "string",
      "pattern": "^sources/src-[0-9a-f]{24}/(?:normalized\\.md|normalizations/norm-[0-9a-f]{16}\\.md)$"
    },
    "normalization_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision_id", "normalized_path", "normalized_hash", "adapter", "adapter_version", "created_at", "supersedes", "extraction_status", "warnings"],
      "properties": {
        "revision_id": {"type": "string", "pattern": "^norm-[0-9a-f]{16}$"},
        "normalized_path": {"$ref": "#/$defs/normalized_path"},
        "normalized_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "adapter": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"},
        "adapter_version": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "supersedes": {"type": ["string", "null"], "pattern": "^norm-[0-9a-f]{16}$"},
        "extraction_status": {"enum": ["complete", "partial", "needs_ocr"]},
        "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "page_count": {"type": "integer", "minimum": 1}
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"}
    }
  }
}
