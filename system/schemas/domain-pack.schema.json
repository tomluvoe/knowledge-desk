{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidence-vault.local/schemas/domain-pack/1.0.0",
  "title": "Domain-pack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "domain_id", "name", "version", "namespace", "description", "extension_schemas"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "domain_id": {"type": "string", "pattern": "^domain-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "namespace": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"},
    "description": {"type": "string", "minLength": 1},
    "extension_schemas": {"type": "array", "items": {"type": "string", "pattern": "^domains/[^/]+/schemas/[^/]+\\.schema\\.json$"}, "uniqueItems": true}
  }
}
