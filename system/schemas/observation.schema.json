{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-desk.local/schemas/observation/1.0.0",
  "title": "Generic temporal observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observation_id", "subjects", "topics", "assertion", "epistemic_class", "statement_basis", "orientation", "confidence", "reasoning", "mechanisms", "conditions", "implications", "catalysts", "risks", "publication_date", "expressed_at", "valid_at", "recorded_at", "horizon", "freshness", "evidence", "relations", "extensions"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "observation_id": {"type": "string", "pattern": "^obs-[0-9]{8}-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "subjects": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entity_reference"}, "uniqueItems": true},
    "topics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/topic_reference"}, "uniqueItems": true},
    "assertion": {"type": "string", "minLength": 1},
    "epistemic_class": {"enum": ["source_statement", "cross_source_synthesis", "agent_hypothesis", "user_conclusion", "user_decision"]},
    "statement_basis": {"enum": ["explicit_statement", "disclosed_action", "hypothetical_example", "agent_inference"]},
    "orientation": {"enum": ["supportive", "critical", "neutral", "mixed", "conditional", "unknown"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "reasoning": {"type": "string"},
    "mechanisms": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "conditions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "implications": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "catalysts": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "risks": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "publication_date": {"type": ["string", "null"], "format": "date"},
    "expressed_at": {"type": ["string", "null"], "format": "date-time"},
    "valid_at": {"type": ["string", "null"], "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "horizon": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["start", "end", "description"], "properties": {"start": {"type": ["string", "null"], "format": "date"}, "end": {"type": ["string", "null"], "format": "date"}, "description": {"type": ["string", "null"]}}}]},
    "freshness": {"type": "object", "additionalProperties": false, "required": ["as_of", "status"], "properties": {"as_of": {"type": ["string", "null"], "format": "date-time"}, "status": {"enum": ["current", "stale", "historical", "unknown"]}}},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
    "relations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["type", "observation_id"], "properties": {"type": {"enum": ["confirms", "contradicts", "refines", "supersedes"]}, "observation_id": {"type": "string", "pattern": "^obs-[0-9]{8}-[a-z0-9]+(?:-[a-z0-9]+)*$"}}}, "uniqueItems": true},
    "extensions": {"type": "object", "propertyNames": {"pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"}}
  },
  "$defs": {
    "entity_reference": {"type": "object", "additionalProperties": false, "required": ["ref_id", "kind", "label"], "properties": {"ref_id": {"type": "string", "pattern": "^entity-[a-z0-9]+(?:-[a-z0-9]+)*$"}, "kind": {"const": "entity"}, "label": {"type": "string", "minLength": 1}}},
    "topic_reference": {"type": "object", "additionalProperties": false, "required": ["ref_id", "kind", "label"], "properties": {"ref_id": {"type": "string", "pattern": "^topic-[a-z0-9]+(?:-[a-z0-9]+)*$"}, "kind": {"const": "topic"}, "label": {"type": "string", "minLength": 1}}},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_hash", "normalized_path", "locator_kind", "selector"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^src-[0-9a-f]{24}$"},
        "source_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "normalized_path": {"type": "string", "pattern": "^sources/src-[0-9a-f]{24}/(?:normalized\\.md|normalizations/norm-[0-9a-f]{16}\\.md)$"},
        "locator_kind": {"enum": ["pdf_page", "markdown_heading", "line_range", "block", "media_timestamp"]},
        "selector": {"type": "object"},
        "quote_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"locator_kind": {"const": "pdf_page"}}, "required": ["locator_kind"]},
          "then": {
            "properties": {
              "selector": {
                "type": "object",
                "additionalProperties": false,
                "required": ["page"],
                "properties": {"page": {"type": "integer", "minimum": 1}}
              }
            }
          }
        },
        {
          "if": {"properties": {"locator_kind": {"const": "markdown_heading"}}, "required": ["locator_kind"]},
          "then": {
            "properties": {
              "selector": {
                "type": "object",
                "additionalProperties": false,
                "required": ["heading", "occurrence"],
                "properties": {
                  "heading": {"type": "string", "minLength": 1},
                  "occurrence": {"type": "integer", "minimum": 1}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"locator_kind": {"const": "line_range"}}, "required": ["locator_kind"]},
          "then": {
            "properties": {
              "selector": {
                "type": "object",
                "additionalProperties": false,
                "required": ["start_line", "end_line"],
                "properties": {
                  "start_line": {"type": "integer", "minimum": 1},
                  "end_line": {"type": "integer", "minimum": 1}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"locator_kind": {"const": "block"}}, "required": ["locator_kind"]},
          "then": {
            "properties": {
              "selector": {
                "type": "object",
                "additionalProperties": false,
                "required": ["block_id"],
                "properties": {"block_id": {"type": "string", "pattern": "^block-[1-9][0-9]*$"}}
              }
            }
          }
        },
        {
          "if": {"properties": {"locator_kind": {"const": "media_timestamp"}}, "required": ["locator_kind"]},
          "then": {
            "properties": {
              "selector": {
                "type": "object",
                "additionalProperties": false,
                "required": ["start_seconds"],
                "properties": {
                  "start_seconds": {"type": "number", "minimum": 0},
                  "end_seconds": {"type": "number", "minimum": 0}
                }
              }
            }
          }
        }
      ]
    }
  }
}
